<%- include('partials/header', {title: 'Watch History', pageStylesheet: '/css/watchhistory.css'}) %>

<main>
    <div id="historysection">
        <h1>Watch History</h1>

      
            <table class="table table-striped table-hover" id="historytable">

                <thead class="table-secondary">
                    <tr>
                        <th>Date</th>
                        <th>Movie Name</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (history.length === 0) { %>
                        <tr>
                            <td colspan="4" style="text-align: center;">No watch history found.</td>
                        </tr>
                    <% } else { %>
                        <% history.forEach(item => { %>
                            <tr>
                                <td><%= new Date(item.booking_date).toLocaleDateString('en-GB') %></td>
                                <td><%= item.title %></td>
                                <td><%= item.quantity %></td>
                                <td>$<%= item.price %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>

            </table>
    </div>
</main>

<%- include('partials/footer') %>
