<%- include('partials/header', {title: 'Home', pageStylesheet: '/css/purchaseTix.css'}) %>

<main>
    <div id="container">
        <div id="banner">
            <h1>Buy Tickets</h1>
        </div>
        
        <form id="moviesection">
                <div class="formItems">
                    <label for="name">Movie:</label>
                    <input type="text" name="name" id="name" value="<%=movie.title%>" disabled>
                </div>
                <div class="formItems">
                    <label for="date">Date:</label>
                    <input type="text" name="date" id="date" value="<%=new Date(movie.date).toLocaleDateString('en-GB')%>"disabled>
                </div>
                
                <div class="formItems">
                    <label for="time">Time:</label>
                    <input type="text" name="time" id="time" value="<%=movie.time%>"disabled>
                </div>
                
                <div class="formItems">
                    <label for="hall">Hall:</label>
                    <input type="text" name="hall" id="hall" value="<%=movie.hall%>"disabled>
                </div>
                
                <div class="formItems">
                    <label for="tixType">Type:</label>
                    <input type="text" name="tixType" id="tixType" value="<%=movie.hall%>">
                </div>
                <div id="seatingMap">
                    <h1 id="screen">Screen</h1>
                    <% rows.forEach(row => { %>
                        <div class="seat-row">
                            <% seats.forEach(seat => { %>
                                <% if (seat.row == row.row) { %>
                                    <div class="individualSeat">
                                        <label for="<%=seat.seat_id%>"><%=seat.row + seat.col_num%></label>
                                        <input<% if (seat.status_name != "Available") { %>
                                            class = "unavailable" disabled
                                        <% } %> type="checkbox" name="<%=seat.seat_id%>" id="<%=seat.seat_id%>">
                                    </div>
                                <% } %>
                            <% }) %>
                        </div>
                    <% }) %>
                </div>
            <button class="buyBtn">Submit</button>
        </form>
    </div>
</main>

<%- include('partials/footer') %>