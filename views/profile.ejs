<%- include('partials/header', {title: 'Profile' , pageStylesheet: '/css/profile.css' }) %>

    <main class="profile-main">
        <section class="profile-content" aria-labelledby="profile-heading">
            <img class="profile-image" src="/images/profile.svg" alt="Profile image">

            <div class="profile-card">
                <h1 id="profile-heading">Profile</h1>
                <form action="/updateProfile" method="POST">
                    <!-- name -->
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="name" name="name" value="<%=user.name %>">
                        <label for="name">Name:</label>
                    </div>

                    <!-- date of birth -->
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="dob" name="dob" value="<%=new Date(user.date_of_birth).toLocaleDateString('en-GB')%>"
                            placeholder="enter dob">
                        <label for="dob">Date Of Birth:</label>
                    </div>

                    <!-- mobile no-->
                    <div class="form-floating mb-3">
                        <input type="tel" class="form-control" id="mobile" name="mobile" placeholder="enter mobile no" value="<%=user.phone_num%>">
                        <label for="mobile">Phone:</label>
                    </div>


                    <!-- email -->
                    <div class="form-floating">
                        <input type="email" class="form-control" id="email" name="email" placeholder="enter email" value="<%=user.email%>">
                        <label for="email">Email:</label>
                    </div>

                    <!-- save and cancel button-->
                    <div class="profile-form-actions">
                        <a href="/movies" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>