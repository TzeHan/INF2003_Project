<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/general.css">
    <% if (typeof pageStylesheet !=='undefined' ) { %>
        <link rel="stylesheet" href="<%= pageStylesheet %>">
        <% } %>

            <!-- bootstrap -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
                integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9"
                crossorigin="anonymous">

            <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
                crossorigin="anonymous">
                </script>

</head>

<body>
    <header>
        <div id="nav1">
            <nav>
                <a href="/"><img id="logo" src="/images/logo.png" alt="logo"></a>

                <a href="/movies">Movies</a>
                <a href="/food">Food</a>
                <a href="">Watch History</a>
            </nav>
        </div>

        <div id="nav2">
            <nav>
                <a href="">
                    <img src="/images/heart.svg" alt="favourites">
                </a>
                <a href="">
                    <img src="/images/shopping_cart.svg" alt="cart">
                </a>
                <a href="/profile">
                    <img src="/images/profile.svg" alt="profile">
                </a>
                <% if (user) { %>
                <a href="/logout">logout</a>
                <% } else { %>
                <a href="/login">login</a>
                <% } %>
            </nav>

        </div>

    </header>