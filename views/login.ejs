<%- include('partials/header', {title: 'Login' , pageStylesheet: '/css/login.css' }) %>
    <main class="login-main">
        <div class="login-form-card">

            <img class="login-logo" src="/images/logo.png" alt="Movie ticket">

            <p class="login-welcome">WELCOME TO MOVIE BOOKING SYSTEM!</p>

            <div class="login-panel">

                <h5>Login</h5>

                <form>
                    <!-- username -->
                    <div class="form-floating mb-3">
                        <input required type="text" class="form-control" id="username" name="username"
                            placeholder="enter username">
                        <label for="username">Username:</label>
                    </div>

                    <!-- password -->
                    <div class="form-floating mb-3">
                        <input required type="text" class="form-control" id="password" name="password"
                            placeholder="enter password">
                        <label for="name">Password:</label>
                    </div>

                    <!-- login-->
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>

                <p class="register-prompt">Don't have an account? <a href="/register">Register</a></p>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>