<%- include('partials/header', {title: 'Home', pageStylesheet: '/css/food.css'}) %>

<main>
    <div id="banner">
    </div>
    
    <div id="moviesection">
        <h1>Movies</h1>
        <div id="movieblocks">
            <% food.forEach(element => { %>
                <div class="card">
                    <a href="">
                        <img src="/images/" alt="">
                        <p class="title"><%=element.name%></p>
                        <p class="duration"><%=element.price%></p>
                    </a>
                    <button class="buyBtn">Add</button>
                </div>
            <% }) %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>