<%- include('partials/header', {title: 'Food History', pageStylesheet: '/css/foodhistory.css'}) %>

<main>
    <div id="historysection">
        <h1>Food History</h1>

        <table class="table table-bordered table-striped table-hover" id="historytable">
            <thead class="table-secondary">
                <tr>
                    <th>Date</th>
                    <th>Food Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                <% if (history.length === 0) { %>
                    <tr>
                        <td colspan="4" style="text-align: center;">No food history found.</td>
                    </tr>
                <% } else { %>
                    <% history.forEach(item => { %>
                        <tr>
                            <td><%= new Date(item.order_date).toLocaleDateString('en-GB') %></td>
                            <td><%= item.name %></td>
                            <td><%= item.quantity %></td>
                            <td>$<%= item.price %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
