<%- include('partials/header', {title: 'Home', pageStylesheet: '/css/index.css'}) %>

<main>
    <div id="banner">
        <img src="/images/movie_banner2.jpg" alt="banner">
    </div>
    
    <div id="moviesection">
        <h1>Movies</h1>
        <div id="movieblocks">
            <% movies.forEach(element => { %>
                <div class="card">
                   <a href="
                        <% if (user && user.type_id == 2) { %>
                            /admin/movie/edit/<%= element.product_id %>
                        <% } else { %>
                            /movieDetails/<%= element.product_id %>
                        <% } %>
                    ">                   
                        <img src="/images/<%= element.img  %>" alt="">
                        <p class="title"><%=element.title%></p>
                        <p class="duration"><%=element.duration%></p>
                    </a>
                    <button class="buyBtn">Buy Tickets</button>
                </div>
            <% }) %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>